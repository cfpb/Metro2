{
  "name": "front-end",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "vite build --base=/static/",
    "dev": "vite",
    "preview": "vite preview",
    "preview:test": "start-server-and-test preview http://localhost:4173",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:component": "yarn cypress open --component",
    "test:component:headless": "yarn cypress run --component",
    "test:component:ci": "yarn cypress run --component --record",
    "test:e2e": "yarn cypress open --e2e",
    "test:e2e:headless": "yarn cypress run --e2e",
    "test:e2e:ci": "yarn cypress run --e2e --record",
    "test:cypress": "yarn cypress open",
    "test:cypress:headless": "yarn cypress run --component && cypress run --e2e",
    "format": "prettier -uw --cache --ignore-path .gitignore .",
    "run-tsc": "tsc",
    "run-eslint": "eslint --cache --fix .",
    "run-stylelint": "stylelint --cache --fix --ignore-path .gitignore **/*.scss",
    "lint": "run-p run-tsc run-eslint run-stylelint",
    "validate": "run-p lint test:ci test:cypress:headless"
  },
  "dependencies": {
    "@cfpb/cfpb-design-system": "^4.4.0",
    "@cfpb/design-system-react": "0.0.15",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.163.3",
    "@tanstack/router-devtools": "^1.163.3",
    "ag-grid-community": "^35.1.0",
    "ag-grid-react": "^35.1.0",
    "exceljs": "^4.4.0",
    "query-string": "^9.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cfpb/browserslist-config": "^0.0.6",
    "@eslint/js": "^10.0.1",
    "@nabla/vite-plugin-eslint": "^3.0.0",
    "@testing-library/cypress": "^10.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chai": "^5.2.3",
    "@types/css-mediaquery": "0.1.4",
    "@types/cypress": "^1.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/testing-library__jest-dom": "6.0.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-istanbul": "^4.0.18",
    "autoprefixer": "10.4.27",
    "css-mediaquery": "0.1.2",
    "csstype": "^3.2.3",
    "cypress": "^15.11.0",
    "cypress-real-events": "^1.15.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-cypress": "^6.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-prefer-function-component": "3.4.0",
    "eslint-plugin-testing-library": "7.16.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.4.0",
    "jsdom": "28.1.0",
    "lint-staged": "16.2.7",
    "msw": "^2.12.10",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "sass": "^1.97.3",
    "start-server-and-test": "2.1.5",
    "stylelint": "^17.4.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "browserslist": "> 0.2% in @cfpb/browserslist-config stats",
  "lint-staged": {
    "*": "prettier -uw --cache",
    "*.css": "stylelint --cache --fix",
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "vitest related --run --coverage=false"
    ]
  },
  "packageManager": "yarn@4.12.0"
}
