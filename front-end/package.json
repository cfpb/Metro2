{
  "name": "front-end",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "vite build --base=/static/",
    "dev": "vite",
    "preview": "vite preview",
    "preview:test": "start-server-and-test preview http://localhost:4173",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:component": "yarn cypress open --component",
    "test:component:headless": "yarn cypress run --component",
    "test:component:ci": "yarn cypress run --component",
    "test:e2e": "yarn cypress open --e2e",
    "test:e2e:headless": "yarn cypress run --e2e",
    "test:e2e:ci": "yarn cypress run --e2e",
    "test:cypress": "yarn cypress open",
    "test:cypress:headless": "yarn cypress run --component && cypress run --e2e",
    "format": "prettier -uw --cache --ignore-path .gitignore .",
    "run-tsc": "tsc",
    "run-eslint": "eslint --cache --fix .",
    "run-stylelint": "stylelint --cache --fix --ignore-path .gitignore **/*.scss",
    "lint": "run-p run-tsc run-eslint run-stylelint",
    "validate": "run-p lint test:ci test:cypress:headless"
  },
  "dependencies": {
    "@cfpb/cfpb-design-system": "^5.8.0",
    "@cfpb/design-system-react": "^2.0.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/router-devtools": "^1.167.0",
    "ag-grid-community": "^35.1.0",
    "ag-grid-react": "^35.1.0",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "query-string": "^9.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cfpb/browserslist-config": "^0.0.7",
    "@eslint/js": "^10.0.1",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chai": "^5.2.3",
    "@types/css-mediaquery": "^0.1.4",
    "@types/cypress": "^1.1.6",
    "@types/dompurify": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "css-mediaquery": "0.1.2",
    "csstype": "^3.2.3",
    "cypress": "^16.1.1",
    "cypress-real-events": "^1.15.1",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-prefer-function-component": "^5.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "start-server-and-test": "^3.0.13",
    "stylelint": "^17.16.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "minimatch@npm:5.1.6": "~5.1.8",
    "minimatch@npm:3.1.2": "~3.1.5",
    "brace-expansion": "5.0.12",
    "uuid": "14.0.0",
    "tmp": "0.2.7",
    "async": "3.2.6",
    "@babel/runtime": "~7.28.4",
    "unzipper@npm:0.10.14": "~0.12.5"
  },
  "browserslist": "> 0.2% in @cfpb/browserslist-config stats",
  "lint-staged": {
    "*": "prettier -uw --cache",
    "*.css": "stylelint --cache --fix",
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "vitest related --run --coverage=false"
    ]
  },
  "packageManager": "yarn@4.12.0"
}
